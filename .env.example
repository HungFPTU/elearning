# ---------- API (apps/api) ----------
# Postgres connection (matches docker-compose.yml)
DATABASE_URL=postgresql://elearning:elearning@localhost:5432/elearning?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Access token (JWT). Use a long random string in real environments.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
# Access token lifetime in seconds (900 = 15 minutes)
JWT_ACCESS_TTL_SECONDS=900
# Refresh tokens are opaque random strings stored hashed in the DB
REFRESH_TOKEN_TTL_DAYS=30
# Seed only: `pnpm db:seed` creates (or promotes) this account as the site Owner.
# Leave OWNER_PASSWORD empty to use the dev password Password123!
OWNER_EMAIL=
OWNER_PASSWORD=

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000/api
